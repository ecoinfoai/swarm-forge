# Project commands. Recipe names are the same in every swarm project; only
# their bodies change. Roles keep the recipes for the checks they own correct.
# Run one at a time: the tools share caches and must not run concurrently.

# SwarmForge installs the APS tools (gherkin-parser, gherkin-mutator) here and
# puts them on the agents' PATH only; recipes must work the same for the operator.
export PATH := justfile_directory() + "/.swarmforge/bin:" + env_var("PATH")

# Standard verification suite.
check: test property acceptance

# Unit tests.
test:
    julia --project -e 'using Pkg; Pkg.test()'

# Property tests.
property:
    @echo "property: not wired yet; the refactorer defines it with the property framework" >&2; exit 1

# Every feature through the acceptance pipeline.
acceptance:
    @echo "acceptance: not wired yet; the coder defines it with the acceptance pipeline" >&2; exit 1

# Coverage report.
coverage:
    julia --project -e 'using Pkg; Pkg.test(coverage=true)'

# Cyclomatic complexity for CRAP.
crap:
    @echo "crap: not wired yet; the refactorer defines it" >&2; exit 1

# Duplicate code.
dry:
    @echo "dry: not wired yet; the refactorer defines it" >&2; exit 1

# Julia has no maintained mutation tool; the language rules skip this check.
mutate:
    @echo "mutate: skipped, Julia has no maintained mutation tool"

# Soft Gherkin acceptance mutation.
gherkin-mutate:
    @echo "gherkin-mutate: not wired yet; the architect defines it with the mutation runner" >&2; exit 1

# End-to-end QA suite through the user interface (six-pack QA role).
qa:
    @echo "qa: not wired yet; the QA role defines it with the end-to-end suite" >&2; exit 1

# Render the Quarto site.
docs:
    quarto render docs
